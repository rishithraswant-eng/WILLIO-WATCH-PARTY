# ---- Willio environment ----
# Everything is optional for local dev: without DATABASE_URL / REDIS_URL the server
# runs fully in-memory with file snapshots in ./.data (see docs/DECISIONS.md).

NODE_ENV=development

# Server
PORT_SERVER=4000
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed web origins. Empty in development = reflect any origin.
CORS_ORIGIN=http://localhost:3000
ROOM_MAX_USERS=50
# Enables the host-only "Chaos Mode" demo tools.
CHAOS_ENABLED=true

# Durable storage (optional)
DATABASE_URL=postgresql://willio:willio@localhost:5432/willio
REDIS_URL=redis://localhost:6379

# Movie data (optional; bundled catalog.json is used when absent)
TMDB_API_KEY=

# Web
PORT_WEB=3000
# Where the browser reaches the realtime server. When empty the web app uses
# <current page protocol>//<current page host>:4000, which works on LAN out of the box.
NEXT_PUBLIC_WS_URL=
