{
  "name": "@willio/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "catalog:generate": "tsx scripts/generate-catalog.ts"
  },
  "dependencies": {
    "@willio/shared": "*",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.1",
    "fuse.js": "^7.1.0",
    "ioredis": "^5.8.2",
    "jose": "^5.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.0",
    "vitest": "^3.2.7"
  }
}
